# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Vercel
.vercel

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*


!.env.example
!**/.env.example

# Python virtual environments
backend/.venv/
backend/venv/
.venv/
venv/

# Python cache / compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases
backend/*.db
backend/*.sqlite
backend/*.sqlite3
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Certificates / private keys
*.pem
*.key

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/
.idea/

# Temporary files
*.tmp
*.temp